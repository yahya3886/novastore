<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Depo indeksi ve APK indirme için -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- APK kurabilmek için "bilinmeyen uygulamalar" erişimi -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Kaldırma ekranını açabilmek için. Android 9+ (API 28) hedefleyen
         uygulamalar ACTION_UNINSTALL_PACKAGE ve PackageInstaller.uninstall
         kullanmak için bu izni zorunlu tutar (koruma seviyesi: normal —
         kurulumda otomatik verilir). -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <!-- Android 11+ (API 30) paket görünürlüğü: cihazda kurulu sürümleri
         (Güncellemeler/Kurulu ekranı) okumak için diğer paketlere erişim. -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:largeHeap="true"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.NovaStore"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.NovaStore"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- İndirilen APK'ları kurulum ekranına iletmek için -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="dev.novastore.app.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
